  "auditPlaintextHttpTitle": "Sensitive Data Sent Over Plaintext HTTP",
  "auditPlaintextHttpDetailUrl": "This request is sent over plaintext http:// and carries sensitive fields such as passwords / tokens in the URL query string, which a man-in-the-middle can read directly.",
  "auditPlaintextHttpDetailBody": "This request is sent over plaintext http:// and carries sensitive fields such as passwords / tokens in the request body, which a man-in-the-middle can read directly.",
  "auditPlaintextHttpSuggestion": "Use HTTPS; when HTTP is unavoidable, do not carry credentials directly in the URL or request body.",
  "auditPlaintextBodyTitle": "Request Body Sent Over Plaintext HTTP",
  "auditPlaintextBodyDetail": "This request uses http:// and has a request body, so the content is fully plaintext on the wire.",
  "auditPlaintextBodySuggestion": "Enforce HTTPS for endpoints that handle login, payment or privacy.",
  "auditUrlSecretTitle": "Sensitive Parameters in the URL",
  "auditUrlSecretDetail": "Query parameters {names} look like credentials / keys. URLs are written into browser history, proxy and server logs.",
  "@auditUrlSecretDetail": {"placeholders": {"names": {"type": "String"}}},
  "auditUrlSecretSuggestion": "Move sensitive parameters into the request body or headers (for example Authorization).",
  "auditPasswordBodyTitle": "Password Submitted in a Plaintext Body",
  "auditPasswordBodyDetail": "The request body contains fields such as password / pwd with plaintext values.",
  "auditPasswordBodySuggestion": "Keep the whole path on HTTPS and make sure the server never echoes or logs passwords.",
  "auditCookieFlagTitle": "Cookie Missing Security Attributes",
  "auditCookieFlagDetail": "Set-Cookie \"{name}\" is missing {missing}, so it can be read by scripts or transmitted in cleartext.",
  "@auditCookieFlagDetail": {"placeholders": {"name": {"type": "String"}, "missing": {"type": "String"}}},
  "auditCookieFlagSuggestion": "Add Secure and HttpOnly to session cookies, and set SameSite=Lax/Strict as needed.",
  "auditMissingHeadersTitle": "HTML Response Missing Security Headers",
  "auditMissingHeadersDetail": "Missing {missing}; the browser has no extra constraint against content sniffing and script injection.",
  "@auditMissingHeadersDetail": {"placeholders": {"missing": {"type": "String"}}},
  "auditMissingHeadersSuggestion": "Add security response headers such as nosniff and CSP as needed.",
  "auditFingerprintTitle": "Response Exposes Server Fingerprint",
  "auditFingerprintDetail": "{header}: {value}, which helps an attacker pick known vulnerabilities.",
  "@auditFingerprintDetail": {"placeholders": {"header": {"type": "String"}, "value": {"type": "String"}}},
  "auditFingerprintSuggestion": "Hide or generalize version information at the gateway.",
  "auditPrivateKeyTitle": "Response Body May Contain a Private Key",
  "auditPrivateKeyDetail": "A PEM private key marker appears in the response; if it is a real key, this is a severe leak.",
  "auditPrivateKeySuggestion": "Rotate the key immediately and make sure the server never sends private keys to clients.",
  "auditSecretTitle": "Response Body Returns Secret Fields in Plaintext",
  "auditSecretDetail": "Fields such as {names} are returned in plaintext.",
  "@auditSecretDetail": {"placeholders": {"names": {"type": "String"}}},
  "auditSecretSuggestion": "Return the minimum set of fields; key material should never be sent to clients.",
  "auditPiiTitle": "Response Body Contains Personal Information",
  "auditPiiDetail": "Fields such as {names} carry personal data such as ID numbers / phone numbers.",
  "@auditPiiDetail": {"placeholders": {"names": {"type": "String"}}},
  "auditPiiSuggestion": "Mask personal data or return it on a minimal-necessary basis, and comply with data protection requirements.",
  "auditErrorTitle": "Error Response Leaks Internal Information",
  "auditErrorDetail": "Debug / stack trace signatures ({trace}) appear in the response, which may expose the framework, paths or database structure.",
  "@auditErrorDetail": {"placeholders": {"trace": {"type": "String"}}},
  "auditErrorSuggestion": "Disable detailed errors in production and return a generic error message.",
  "auditCorsTitle": "CORS Allows Any Origin with Credentials",
  "auditCorsDetail": "Access-Control-Allow-Origin is * while Allow-Credentials is true, so the risk of cross-site credential reads is high.",
  "auditCorsSuggestion": "Restrict allowed origins to a fixed allowlist and avoid * together with Allow-Credentials.",
  "auditJwtNoneTitle": "JWT Uses alg=none (Unsigned)",
  "auditJwtNoneDetail": "The token declares algorithm none, so anyone can tamper with the payload and it cannot be verified.",
  "auditJwtNoneSuggestion": "Enforce signature algorithm validation on the server and reject alg=none.",
  "auditJwtExpiryTitle": "JWT Has No Expiry",
  "auditJwtExpiryDetail": "The token payload has no exp field, so it stays valid forever after being issued.",
  "auditJwtExpirySuggestion": "Set a reasonable expiry for tokens and support refresh.",
  "auditHttp10Title": "Uses Outdated HTTP/1.0",
  "auditHttp10Detail": "This connection uses HTTP/1.0, whose connection reuse and caching strategy is outdated.",
  "auditHttp10Suggestion": "Upgrade to HTTP/1.1 or HTTP/2.",
  "auditSqlTitle": "Possible SQL Injection Trace (Database Error Echoed)",
  "auditSqlDetail": "The response contains a {signature} database error signature, which means this endpoint echoes SQL errors back to the caller; if client-controlled parameters triggered it, there is a SQL injection risk.",
  "@auditSqlDetail": {"placeholders": {"signature": {"type": "String"}}},
  "auditSqlSuggestion": "Use parameterized queries / prepared statements and never concatenate SQL; disable detailed database errors in production and return a generic message. (Passive detection: based only on the response characteristics of captured traffic; no probe request was sent.)",
  "auditXssTitle": "Possible XSS Reflection Trace (Unencoded Parameters Echoed in HTML)",
  "auditXssDetail": "The response echoes request parameter values verbatim into HTML without HTML entity encoding, and the echoed content contains special characters such as {meta}; if an attacker can control that value, the browser may parse it as tags or script.",
  "@auditXssDetail": {"placeholders": {"meta": {"type": "String"}}},
  "auditXssSuggestion": "Encode according to the output context (HTML entity encoding) and pair the page with CSP; do not concatenate request parameters into HTML. (Passive detection: based only on the response characteristics of captured traffic; no probe request was sent.)",
